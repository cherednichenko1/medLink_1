# Copy to .env (ignored by Git). Generate values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
DB_PASSWORD=
# Optional; keep blank to disable new doctor registration.
DOCTOR_REGISTRATION_CODE=
# Set true only when serving exclusively over HTTPS.
SESSION_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8080
